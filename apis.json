{
  "info": {
    "name": "ASE Authentication & Emergency Team APIs",
    "description": "Postman collection for User Auth and Emergency Team Auth APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "User Authentication",
      "item": [
        {
          "name": "Register User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Verify User Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\"\n}"
            }
          }
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Auth Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Emergency Team Authentication",
      "item": [
        {
          "name": "Register Emergency Team (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911111111111\",\n  \"password\": \"StrongPass1\",\n  \"full_name\": \"Dr Smith\",\n  \"email\": \"smith@hospital.com\",\n  \"role\": \"ADMIN\",\n  \"department\": \"MEDICAL\",\n  \"employee_id\": \"EMP123\"\n}"
            }
          }
        },
        {
          "name": "Verify Emergency Team Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/register/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "register", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911111111111\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Emergency Team Login (Email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"smith@hospital.com\",\n  \"password\": \"StrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Emergency Team Login (Phone)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911111111111\",\n  \"password\": \"StrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Change Emergency Team Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/change-password?team_member_id=UUID-HERE",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "change-password"],
              "query": [{ "key": "team_member_id", "value": "UUID-HERE" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"StrongPass1\",\n  \"new_password\": \"NewStrongPass2\"\n}"
            }
          }
        },
        {
          "name": "Deactivate Emergency Team Member",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/deactivate/UUID-HERE",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "deactivate", "UUID-HERE"]
            }
          }
        },
        {
          "name": "Emergency Team Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "health"]
            }
          }
        }
      ]
    }
  ]
}
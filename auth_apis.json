{
  "info": {
    "name": "Emergency & User Auth APIs",
    "_postman_id": "d7c1a8e2-1234-4c9a-9c3a-abcdef123456",
    "description": "Collection for User Auth and Emergency Team Auth APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "User Auth APIs",
      "item": [
        {
          "name": "Register User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/verify",
              "host": ["{{base_url}}"],
              "path": ["auth", "register", "verify"]
            }
          }
        },
        {
          "name": "Login User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/verify",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "verify"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"YOUR_REFRESH_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "token", "refresh"]
            }
          }
        },
        {
          "name": "Auth Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/health",
              "host": ["{{base_url}}"],
              "path": ["auth", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Emergency Team APIs",
      "item": [
        {
          "name": "Register Team Member (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"password\": \"StrongPass1\",\n  \"full_name\": \"Team Member\",\n  \"email\": \"team@example.com\",\n  \"role\": \"admin\",\n  \"department\": \"medical\",\n  \"employee_id\": \"EMP001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/emergency-team/register",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "register"]
            }
          }
        },
        {
          "name": "Verify Team Member Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/emergency-team/register/verify",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "register", "verify"]
            }
          }
        },
        {
          "name": "Login Team Member (Email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"team@example.com\",\n  \"password\": \"StrongPass1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/emergency-team/login",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "login"]
            }
          }
        },
        {
          "name": "Login Team Member (Phone)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+1234567890\",\n  \"password\": \"StrongPass1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/emergency-team/login",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "login"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"StrongPass1\",\n  \"new_password\": \"NewStrongPass2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/emergency-team/change-password?team_member_id=USER_ID",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "change-password"],
              "query": [
                {
                  "key": "team_member_id",
                  "value": "USER_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Deactivate Team Member",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/emergency-team/deactivate/USER_ID",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "deactivate", "USER_ID"]
            }
          }
        },
        {
          "name": "Emergency Team Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/emergency-team/health",
              "host": ["{{base_url}}"],
              "path": ["emergency-team", "health"]
            }
          }
        }
      ]
    }
  ]
}
{
  "info": {
    "name": "DRS Authentication APIs",
    "description": "User Auth + Emergency Team Auth APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "phone_number",
      "value": "+911234567890"
    },
    {
      "key": "otp",
      "value": "123456"
    },
    {
      "key": "team_member_id",
      "value": "UUID-HERE"
    }
  ],
  "item": [
    {
      "name": "Auth - User",
      "item": [
        {
          "name": "Register User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Verify User Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          }
        },
        {
          "name": "Login User (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\"\n}"
            }
          }
        },
        {
          "name": "Verify User Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          }
        },
        {
          "name": "Auth Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/health"
          }
        }
      ]
    },
    {
      "name": "Auth - Emergency Team",
      "item": [
        {
          "name": "Register Emergency Team (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/emergency-team/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\",\n  \"password\": \"StrongPass1\",\n  \"full_name\": \"Dr Smith\",\n  \"email\": \"dr.smith@example.com\",\n  \"role\": \"admin\",\n  \"department\": \"medical\",\n  \"employee_id\": \"EMP001\"\n}"
            }
          }
        },
        {
          "name": "Verify Emergency Team Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/emergency-team/register/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          }
        },
        {
          "name": "Emergency Team Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/emergency-team/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.smith@example.com\",\n  \"password\": \"StrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Change Emergency Team Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/emergency-team/change-password?team_member_id={{team_member_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"StrongPass1\",\n  \"new_password\": \"NewStrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Deactivate Emergency Team Member",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/emergency-team/deactivate/{{team_member_id}}"
          }
        },
        {
          "name": "Emergency Team Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/emergency-team/health"
          }
        }
      ]
    }
  ]
}

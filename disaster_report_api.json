        {
          "name": "Get Deployment Details (Mission Progress)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/deployments/{{deployment_1_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deployments", "{{deployment_1_id}}"]
            }
          }
        },
        {
          "name": "Update Status → EN_ROUTE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/deployments/{{deployment_1_id}}/update-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deployments", "{{deployment_1_id}}", "update-status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_status\": \"EN_ROUTE\"\n}"
            }
          }
        },
        {
          "name": "Update Status → ON_SCENE (with report)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/deployments/{{deployment_1_id}}/update-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deployments", "{{deployment_1_id}}", "update-status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_status\": \"ON_SCENE\",\n  \"situation_report\": \"Large fire confirmed. 3 floors burning. Multiple casualties.\",\n  \"tags\": [\"casualties_present\", \"road_access_blocked\"],\n  \"minor_injuries\": 4,\n  \"serious_injuries\": 2,\n  \"additional_resources\": [\"MEDICAL_SUPPORT\", \"ADDITIONAL_UNITS\"],\n  \"location_verified\": true,\n  \"request_immediate_backup\": false\n}"
            }
          }
        },
        {
          "name": "Update Status → IN_PROGRESS",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/deployments/{{deployment_1_id}}/update-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deployments", "{{deployment_1_id}}", "update-status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_status\": \"IN_PROGRESS\",\n  \"situation_report\": \"Fire containment in progress. Casualties evacuated.\"\n}"
            }
          }
        },
        {
          "name": "Update Status → COMPLETED",
          "request": {
            "method": "POST",

{
  "info": {
    "name": "ASE Disaster Response APIs",
    "description": "Complete Postman collection for Disaster Reports, Disasters, Emergency Units, and Deployments. All endpoints require Bearer token auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "PASTE_YOUR_JWT_TOKEN_HERE" },
    { "key": "user_id", "value": "4d3cf67d-b479-4cf9-ab5b-b1a5e3d3259c" },
    { "key": "team_member_id", "value": "38132529-b7bd-435c-b7d6-f22609484bb6" },
    { "key": "unit_f05_id", "value": "" },
    { "key": "unit_a08_id", "value": "" },
    { "key": "unit_p15_id", "value": "" },
    { "key": "disaster_id", "value": "" },
    { "key": "deployment_1_id", "value": "" },
    { "key": "deployment_2_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}" }]
  },
  "item": [
    {
      "name": "0. Get Auth Token",
      "item": [
        {
          "name": "Login Emergency Team (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    console.log('Token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/emergency-team/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency-team", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"smith@hospital.com\",\n  \"password\": \"StrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Login User (get citizen token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    console.log('Citizen token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+911234567890\",\n  \"otp\": \"123456\"\n}"
            }
          }
        }
      ]
    },

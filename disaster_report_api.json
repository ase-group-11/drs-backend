        {
          "name": "Completed Missions (Responder)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/deployments/unit/{{unit_f05_id}}/completed",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deployments", "unit", "{{unit_f05_id}}", "completed"]
            }
          }
